{
  "name": "multibhashi-admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node --env-file=../.env ace serve --hmr",
    "test": "node --env-file=../.env ace test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#helpers/*": "./app/helpers/*.js",
    "#services/*": "./app/services/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#rbac/*": "./app/rbac/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "7.8.2",
    "@adonisjs/eslint-config": "2.1.2",
    "@adonisjs/prettier-config": "^1.4.4",
    "@adonisjs/tsconfig": "1.4.1",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "4.0.0",
    "@japa/runner": "4.5.0",
    "@swc/core": "1.11.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "@types/nodemailer": "^6.4.17",
    "@types/proxy-addr": "^2.0.3",
    "eslint": "^9.26.0",
    "hot-hook": "0.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "^3.5.3",
    "ts-node-maintained": "10.9.6",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@adonisjs/core": "6.21.0",
    "@adonisjs/lucid": "21.8.2",
    "@vinejs/vine": "3.0.1",
    "livekit-server-sdk": "2.15.4",
    "luxon": "3.7.2",
    "mysql2": "3.22.4",
    "nodemailer": "^6.9.16",
    "proxy-addr": "2.0.7",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
