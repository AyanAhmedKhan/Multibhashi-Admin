# Admin console: copy to .env at this folder's root (the api reads ../.env).

TZ=Asia/Kolkata
NODE_ENV=production
PORT=3500
HOST=0.0.0.0
LOG_LEVEL=info
# 32+ random bytes. Signs the session cookie and encrypts MFA secrets: rotating it signs
# everyone out and forces MFA re-enrolment.
APP_KEY=
# The console's public origin(s), comma separated, https only in production.
CONSOLE_ORIGINS=https://admin.multibhashi.com

# Shared MySQL. Use a dedicated user for the console (see docs/PLAN.md, "Database access").
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# LiveKit project of the AI tutor (live classes page, "End class")
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Tutor API base URL, for the health page
TUTOR_API_URL=

# Email for sign-in codes and invites (optional locally: without it, mail is written to api/tmp/mail/)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Product analytics (docs/PRODUCT_ANALYTICS.md): the BigQuery dataset the app's collector
# writes events into (asia-south1). All optional: without them the product analytics tabs on
# Insights say "not connected yet" and the analytics:* commands do nothing. Never point a
# local copy at the production dataset.
GCP_ANALYTICS_PROJECT=
GCP_ANALYTICS_DATASET=product_analytics
# Service account key: the JSON on one line (or base64), or a path to the key file.
GCP_ANALYTICS_CREDENTIALS_JSON=
GCP_ANALYTICS_CREDENTIALS_FILE=
# Who gets the Monday product digest (analytics:weekly-digest), comma-separated addresses.
ANALYTICS_DIGEST_TO=
