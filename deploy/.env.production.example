# Admin console API, production. Never commit the filled-in copy.
TZ=Asia/Kolkata
NODE_ENV=production
HOST=0.0.0.0
PORT=3500
LOG_LEVEL=info
# 32+ random bytes, generated once: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs sessions and encrypts MFA secrets: rotating it signs everyone out and resets MFA.
APP_KEY=
# The public https origin exactly as staff type it (no trailing slash).
CONSOLE_ORIGINS=https://admin.93-127-172-184.sslip.io

# MySQL: a DEDICATED console user, least privilege (docs/PLAN.md §2), not the tutor's or root.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=multibhashi
# Strongly recommended on a production database: a read replica for Insights.
# DB_ANALYTICS_HOST=
# DB_ANALYTICS_USER=
# DB_ANALYTICS_PASSWORD=

# The SAME LiveKit project the deployed tutor uses (Live classes page, End class).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tutor API base URL for the health page (internal URL is fine).
TUTOR_API_URL=

# Email for sign-in codes and invites. Gmail: an App Password (needs 2-Step Verification on
# the Google account). Leave empty and the console uses authenticator-app codes instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
