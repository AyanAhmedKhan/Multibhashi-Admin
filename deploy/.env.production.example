# Admin console API, production. Never commit the filled-in copy.
TZ=Asia/Kolkata
NODE_ENV=production
HOST=0.0.0.0
PORT=3500
LOG_LEVEL=info
# 32+ random bytes, generated once: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs sessions and encrypts MFA secrets: rotating it signs everyone out and resets MFA.
APP_KEY=
# The public https origin exactly as staff type it (no trailing slash).
CONSOLE_ORIGINS=https://admin.93-127-172-184.sslip.io

# MySQL: a DEDICATED console user, least privilege (docs/PLAN.md §2), not the tutor's or root.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=multibhashi
# Strongly recommended on a production database: a read replica for Insights.
# DB_ANALYTICS_HOST=
# DB_ANALYTICS_USER=
# DB_ANALYTICS_PASSWORD=

# The SAME LiveKit project the deployed tutor uses (Live classes page, End class).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tutor API base URL for the health page (internal URL is fine).
TUTOR_API_URL=

# Email for sign-in codes and invites. Gmail: an App Password (needs 2-Step Verification on
# the Google account). Leave empty and the console uses authenticator-app codes instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The providers' own usage and billing (docs/QUIZ_OBSERVABILITY.md §3): the whole OpenAI
# organisation and the whole GCP billing account are synced (Cost page → Full bill); the quiz
# ids only attribute part of it to the quizzes. All optional: leave empty and the Cost page says
# "not connected" and the quiz figures are estimates.
# An OpenAI ORGANISATION ADMIN key (platform.openai.com → Settings → Admin keys), not an API key.
OPENAI_ADMIN_KEY=
# Attribution: the quiz backend's OpenAI project id (proj_…) and/or key ids (key_…, comma separated).
OPENAI_QUIZ_PROJECT_ID=
OPENAI_QUIZ_API_KEY_IDS=
# GCP service account with BigQuery Data Viewer on the billing export dataset + BigQuery Job User:
# the key JSON on one line (or base64), or a path to the key file inside the container.
GCP_BILLING_CREDENTIALS_JSON=
GCP_BILLING_CREDENTIALS_FILE=
# project.dataset.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX (billing account 016513-594D05-0EF1D5)
GCP_BILLING_EXPORT_TABLE=
# Attribution: the project quiz speech-to-text is billed to.
GCP_SPEECH_PROJECT_ID=

# Product analytics (docs/PRODUCT_ANALYTICS.md, MUL-125): the BigQuery dataset product_analytics
# in asia-south1 that the app's collector writes into. The console exports the business facts,
# builds the nightly models and reads them on Insights. All optional: leave empty and the
# product analytics tabs say "not connected yet".
# The GCP project that holds the dataset and runs the console's jobs.
GCP_ANALYTICS_PROJECT=
GCP_ANALYTICS_DATASET=product_analytics
# The console's service account: BigQuery Data Editor on the dataset + BigQuery Job User on the
# project. The key JSON on one line (or base64), or a path to the key file inside the container.
GCP_ANALYTICS_CREDENTIALS_JSON=
GCP_ANALYTICS_CREDENTIALS_FILE=
# Who gets the Monday product digest (analytics:weekly-digest): comma-separated e-mail addresses
# (a team list is easiest). Sent through the SMTP settings above.
ANALYTICS_DIGEST_TO=
